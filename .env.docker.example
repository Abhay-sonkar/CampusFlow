# Copy this file to ".env" (same folder as docker-compose.yml) and fill in the two secrets.
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use two DIFFERENT values. Never commit the real .env file.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional
CLIENT_URL=http://localhost:5173
# Real emails (leave empty to only print them in the worker log)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
