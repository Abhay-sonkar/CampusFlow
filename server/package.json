{
  "name": "campusflow-server",
  "version": "1.0.0",
  "private": true,

  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "bullmq": "^6.7.8",
    "ioredis": "^6.0.0",
    "mongoose": "^9.12.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.4.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15"
  }
}
